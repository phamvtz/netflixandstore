# =============================================================================
# Netflix Store — mẫu biến môi trường
# =============================================================================
# Cách dùng: copy file này thành `.env` ở thư mục gốc repo, rồi điền giá trị thật.
# Lưu ý: file `.env` đã nằm trong .gitignore — KHÔNG đưa lên GitHub / gửi công khai.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — dùng cho frontend (Vite) + có thể dùng cho server
# -----------------------------------------------------------------------------
# Lấy ở đâu: Supabase Dashboard → dự án của bạn → Project Settings (biểu tượng bánh răng)
#           → mục "API"
#
# VITE_SUPABASE_URL
#   → "Project URL" (dạng https://xxxxxxxx.supabase.co)
#
# VITE_SUPABASE_ANON_KEY
#   → "Publishable" hoặc "anon" / "public" key — key dành cho trình duyệt.
#   → Phải cấu hình RLS (Row Level Security) đúng trong SQL; không dùng service_role ở đây.
#
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# -----------------------------------------------------------------------------
# PostgreSQL — server Node (server.cjs) kết nối DB trực tiếp
# -----------------------------------------------------------------------------
# Lấy ở đâu: Supabase → Project Settings → Database
#   → "Connection string" → chọn tab URI
#   → Bật "Use connection pooling" nếu có (Transaction pooler, cổng thường là 6543)
#
# Khuyến nghị: dùng **Pooler** (host dạng ...pooler.supabase.com, port 6543) để tránh
# lỗi kết nối / giới hạn khi chạy trên VPS hoặc nhiều process.
#
# Thay [YOUR-PASSWORD] bằng mật khẩu database (Settings → Database → Database password).
# Project ref nằm trong URL project (chuỗi trước .supabase.co).
#
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=netcredit

# -----------------------------------------------------------------------------
# MB Bank — xác nhận chuyển khoản tự động (poll lịch sử)
# -----------------------------------------------------------------------------
# Dịch vụ: https://thueapibank.vn/home/mbbank — đăng ký / lấy token theo hướng dẫn của họ.
#
# MBBANK_API_TOKEN
#   → Token gắn vào URL: GET {MBBANK_HISTORY_BASE}/{token}
#
# MBBANK_HISTORY_BASE (có thể để mặc định)
#   → Mặc định: https://thueapibank.vn/historyapimbbank
#
MBBANK_API_TOKEN=31b10ce6076bf41a33df4d00752e2fa3
MBBANK_HISTORY_BASE=https://thueapibank.vn/historyapimbbank

# -----------------------------------------------------------------------------
# Ngân hàng hiển thị trên trang thanh toán (khi Admin chưa điền STK trong Settings)
# -----------------------------------------------------------------------------
# Ưu tiên: Admin → cấu hình bank trong site. Các biến này chỉ là fallback.
#
DEFAULT_BANK_NAME=MB Bank
DEFAULT_BANK_ACCOUNT=
DEFAULT_BANK_OWNER=

# -----------------------------------------------------------------------------
# Cổng chạy server Node
# -----------------------------------------------------------------------------
PORT=3001

# -----------------------------------------------------------------------------
# Bảo mật Admin (API server)
# -----------------------------------------------------------------------------
# Tự đặt một chuỗi dài, ngẫu nhiên (vd: openssl rand -hex 32).
# Dùng khi gọi các route admin qua header/query theo code server.cjs.
#
ADMIN_SECRET=change-me-to-a-long-random-secret

# -----------------------------------------------------------------------------
# Webhook thanh toán (TÙY CHỌN — định dạng VA cũ)
# -----------------------------------------------------------------------------
# Nếu không dùng SePay / VA webhook, để trống hoặc xóa dòng.
# Nếu có: đặt cùng secret với cấu hình webhook bên nhà cung cấp.
#
SEPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Telegram — thông báo đơn hàng / cảnh báo kho (tùy chọn)
# -----------------------------------------------------------------------------
# Bot token: Telegram → @BotFather → /newbot → copy token.
# Chat ID: thêm bot vào nhóm hoặc chat riêng; lấy ID qua @userinfobot hoặc API getUpdates.
#
TELEGRAM_BOT_TOKEN=8352668128:AAFVov1n0uS4VqaME0bcqcRpB1AKtVv9MYw
TELEGRAM_CHAT_ID=1152334182

# -----------------------------------------------------------------------------
# Email Gmail — gửi mail kích hoạt (tùy chọn)
# -----------------------------------------------------------------------------
# Google Account → Bảo mật → Xác minh 2 bước → Mật khẩu ứng dụng → tạo mật khẩu cho "Mail".
# KHÔNG dùng mật khẩu đăng nhập Gmail thường.
#
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Netflix Store

# -----------------------------------------------------------------------------
# Tùy chọn — tên miền site chính (phân biệt với gian hàng subdomain)
# -----------------------------------------------------------------------------
# Nhiều domain cách nhau bằng dấu phẩy. Mặc định trong code: localhost,127.0.0.1
#
# MAIN_DOMAINS=localhost,127.0.0.1,example.com
