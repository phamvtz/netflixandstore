# =============================================================================
# Netflix Store — Mẫu biến môi trường
# =============================================================================
# Cách dùng:
#   1. Copy file này: cp .env.example .env
#   2. Điền giá trị thật vào .env
#   3. KHÔNG commit file .env lên Git (đã trong .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Dùng cho Frontend Auth (đăng nhập/đăng ký người dùng)
# -----------------------------------------------------------------------------
# Lấy tại: Supabase Dashboard → Project Settings → API
#
#   VITE_SUPABASE_URL   = "Project URL" (https://xxxxxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = "anon / public" key (không phải service_role!)
#
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# -----------------------------------------------------------------------------
# MongoDB — Database chính (thay thế PostgreSQL)
# -----------------------------------------------------------------------------
# MongoDB Atlas (khuyến nghị):
#   1. Tạo cluster tại https://cloud.mongodb.com
#   2. Database Access → Add user với role "Atlas admin" hoặc "readWriteAnyDatabase"
#   3. Network Access → Allow từ IP VPS (hoặc 0.0.0.0/0 nếu cần)
#   4. Clusters → Connect → "Connect your application" → copy URI
#
# MONGODB_URI format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Sau khi điền URI, chạy để tạo indexes:
#   npm run mongo:indexes
#
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=netcredit


# -----------------------------------------------------------------------------
# ThueBank — Xác nhận thanh toán MB Bank tự động
# -----------------------------------------------------------------------------
# Dịch vụ: https://thueapibank.vn/home/mbbank
# Hướng dẫn:
#   1. Đăng ký tài khoản tại thueapibank.vn
#   2. Vào trang MB Bank → thuê API → lấy token
#   3. Token dùng để poll lịch sử: GET {MBBANK_HISTORY_BASE}/{token}
#
# Lưu ý: Token cần được gia hạn định kỳ theo gói thuê.
# Polling: Server tự động poll mỗi 5 giây.
#
MBBANK_API_TOKEN=your_thueapibank_token_here
MBBANK_HISTORY_BASE=https://thueapibank.vn/historyapimbbank

# -----------------------------------------------------------------------------
# Thông tin ngân hàng hiển thị (fallback khi Admin chưa cấu hình trong Settings)
# -----------------------------------------------------------------------------
# Ưu tiên: Admin → Settings → bank_name/bank_account/bank_owner trong DB
# Các biến này chỉ là fallback mặc định.
#
DEFAULT_BANK_NAME=MB Bank
DEFAULT_BANK_ACCOUNT=your_account_number
DEFAULT_BANK_OWNER=YOUR NAME IN CAPS

# -----------------------------------------------------------------------------
# Cổng server Node.js
# -----------------------------------------------------------------------------
PORT=3002

# -----------------------------------------------------------------------------
# Bảo mật Admin
# -----------------------------------------------------------------------------
# QUAN TRỌNG: Đặt chuỗi dài, ngẫu nhiên (tối thiểu 32 ký tự).
# Tạo ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dùng khi gọi API admin qua header: x-admin-secret: <value>
#
ADMIN_SECRET=change-me-to-a-long-random-secret-minimum-32-chars

# -----------------------------------------------------------------------------
# Webhook thanh toán (TÙY CHỌN — định dạng SePay VA cũ)
# -----------------------------------------------------------------------------
# Nếu không dùng SePay webhook, để trống.
# Khi có: đặt cùng secret với cấu hình bên nhà cung cấp webhook.
#
SEPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Telegram Bot — Thông báo đơn hàng, cảnh báo kho
# -----------------------------------------------------------------------------
# Tạo bot: Telegram → @BotFather → /newbot → copy token
# Lấy Chat ID: Thêm bot vào nhóm → gọi API getUpdates → lấy chat.id
#              Hoặc nhắn tin trực tiếp với bot → dùng @userinfobot
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Gmail SMTP — Gửi email kích hoạt và thông báo
# -----------------------------------------------------------------------------
# Bật App Password:
#   Google Account → Bảo mật → Xác minh 2 bước → Mật khẩu ứng dụng → Mail
# KHÔNG dùng mật khẩu Gmail thông thường.
#
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=Netflix Store

# -----------------------------------------------------------------------------
# Tên miền chính (phân biệt với gian hàng seller subdomain)
# -----------------------------------------------------------------------------
# Nhiều domain cách nhau bằng dấu phẩy.
# Mặc định: localhost,127.0.0.1
#
# MAIN_DOMAINS=localhost,127.0.0.1,yourdomain.com
